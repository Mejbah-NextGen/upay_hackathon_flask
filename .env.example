SECRET_KEY=replace-with-a-long-random-secret
DEMO_OTP=123456
APP_NAME=UpayX
# DATABASE_URL=sqlite:///instance/upay_hackathon.db
# Optional hosted AI; the app assistant works locally without this key.
# OPENAI_API_KEY=your-api-key
ASSISTANT_MODEL=gpt-4.1-mini

# Production profile: wsgi:app; install requirements-production.txt.
# These keys must be independently generated; never use the demo secret.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=verify-full
# DATA_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
# DATA_ENCRYPTION_KEYS=NEW_ACTIVE_KEY,OLD_READ_KEY
# SECURITY_HASH_KEY=GENERATE_32_OR_MORE_RANDOM_CHARACTERS
# AUDIT_SIGNING_KEY=GENERATE_32_OR_MORE_RANDOM_CHARACTERS
# OBSERVABILITY_TOKEN=GENERATE_32_OR_MORE_RANDOM_CHARACTERS
# TRUST_PROXY=1
# Register OTP_DELIVERY_ADAPTER in a trusted app configuration for real sign-ins.
# Reference sandbox ONLY; this does not activate Bangladesh upay rails.
# PROVIDER_BASE_URL=https://your-reference-sandbox.example
# PROVIDER_SIGNING_SECRET=GENERATE_32_OR_MORE_RANDOM_CHARACTERS
# Local Docker infrastructure lab ONLY (see docs/DEPLOYMENT.md):
# POSTGRES_PASSWORD=GENERATE_RANDOM_PASSWORD
# DATABASE_SSL_REQUIRED=0
